# ── Git & GitHub ───────────────────────────────────────
.git/
.gitignore
.gitattributes
.github/

# ── IDE ────────────────────────────────────────────────
.vscode/
.idea/
.claude/

# ── Python virtual environments ───────────────────────
.venv/
venv/
env/
__pycache__/
*.py[cod]

# ── Testing & QA ───────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
tests/

# ── Environment & secrets ─────────────────────────────
.env
.env.*
!.env.prod.example
*.pem
*.key

# ── Docker persistent data (mounted at runtime) ──────
data/
backups/
instance/

# ── User uploads (mounted at runtime) ────────────────
static/uploads/*
!static/uploads/.gitkeep

# ── Documentation (not needed in image) ───────────────
README.md
README.ru.md
CONTRIBUTING.md
CONTRIBUTING.ru.md
DEPLOYMENT.ru.md
LICENCE
план-презентации.md
тезисы.md
docs/

# ── Docker config (not needed inside image) ──────────
docker-compose*.yml
Dockerfile
.dockerignore

# ── OS ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
*.swp
*.swo
